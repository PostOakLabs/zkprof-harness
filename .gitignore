/target
/report.json

# Linter cache.
/.ruff_cache

# wasm-bindgen output. Each profile's .wasm is on the order of 2 MB (the
# committed web/verify page embeds a wasm of ~1.9 MB, and the harness/marshal
# modules are the same order); a "~14 MB" figure once used here was the wrong
# estimate and is corrected. Committing them would put build artefact in
# history, and they are regenerated by `python tools/build_wasm.py`. The pages
# need them present but not tracked.
/web/harness/pkg-*/
/web/marshalling-bench/pkg-*/

# The prebuilt wasm-bindgen CLI is downloaded, not vendored. `cargo install`
# cannot build it here (needs dlltool), so `tools/build_wasm.py` prints the
# exact asset and checksum to fetch instead.
/tools/bin/

# Derived corpus-sweep outputs (oracles + verdicts). These are regenerated by
# `cargo run -p zkprof-verify --bin dump -- --out-dir fixtures/corpus-sweep/oracles`,
# `cargo run -p zkprof-verify --bin corpus_sweep`, and
# `node web/twin/run-corpus-twin.mjs`; the resulting docs/TWIN-CORPUS-SWEEP.md is
# the committed deliverable, the intermediates are not.
/crates/zkprof-verify/fixtures/corpus-sweep/
